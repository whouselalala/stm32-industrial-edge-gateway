[Unit]
Description=Linux Industrial Edge Gateway
After=network.target

[Service]
Type=notify
DynamicUser=yes
SupplementaryGroups=dialout
StateDirectory=linux-edge-gateway
WorkingDirectory=/var/lib/linux-edge-gateway
EnvironmentFile=-/etc/linux-edge-gateway/mqtt.env
ExecStart=/opt/linux-edge-gateway/.venv/bin/python /opt/linux-edge-gateway/gateway.py --config /etc/linux-edge-gateway/config.toml
Restart=on-failure
RestartSec=3s
WatchdogSec=30s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
